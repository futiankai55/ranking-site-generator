# データベースパス（デフォルトはdata/db/sites.db）
DATABASE_URL=sqlite:///data/db/sites.db

# AdSense広告収益・Search Console検索指標・GA4トラフィックの同期に使用（セットアップ手順: docs/google-api-setup.md）
ADSENSE_ACCOUNT_ID=pub-xxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET_PATH=credentials/adsense_client_secret.json
GOOGLE_TOKEN_PATH=credentials/adsense_token.json
GA4_PROPERTY_ID=xxxxxxxxx
